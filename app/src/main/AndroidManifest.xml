<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cook Mode buzzes when a timer finishes; vibration is a normal permission
         (no runtime prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Timer completion is raised as a notification (Android 13+ asks the user;
         requested contextually in Cook Mode, never at launch). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A kitchen timer must fire on time; on Android 12+ AlarmManager needs this
         special access for exact alarms (setAlarmClock). It is special app access,
         not a runtime dialog, and is never requested at launch. There is NO inexact
         fallback: while the access is missing the app refuses to start a timer and
         explains how to grant it, so a timer can never fire a minute late.
         USE_EXACT_ALARM is deliberately not declared — that auto-granted permission
         is reserved for real clock/alarm apps and cannot be justified for a cooking
         timer. See CookTimerAlarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".MealioApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:theme="@style/Theme.Mealio">

        <!-- AppCompat stores the per-app locale itself on Android 12 and lower
             (on Android 13+ the framework stores it). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires when a Cook Mode timer ends, even while the app is backgrounded. -->
        <receiver
            android:name=".cook.CookTimerReceiver"
            android:exported="false" />

    </application>

</manifest>
